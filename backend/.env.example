# ---------------------------------------------------------------------------
# Backend environment variables (Express on Render)
# ---------------------------------------------------------------------------
# These values are SERVER-SIDE ONLY. Never expose SUPABASE_SERVICE_ROLE_KEY,
# DEVICE_TOKEN_PEPPER, or any backend secret to the frontend.
# ---------------------------------------------------------------------------

# Port the Express server listens on. Render injects process.env.PORT.
PORT=8080

# "development" | "production" | "test"
NODE_ENV=development

# Default frontend origin used when ALLOWED_ORIGINS is not set (dev convenience).
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (production Netlify domain(s)).
# Example: https://smart-plant-watering.netlify.app,https://staging.example.netlify.app
ALLOWED_ORIGINS=

# Supabase project URL (same as frontend VITE_SUPABASE_URL).
SUPABASE_URL=

# Supabase anon key (public). Used for the auth client context only.
SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — server only. NEVER ship to frontend or device.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used ONLY if you choose the legacy shared-secret JWT verification
# approach AND your Supabase project still exposes the JWT secret. The current
# recommended approach verifies tokens via the JWKS / Supabase client, in which
# case this can be left empty.
SUPABASE_JWT_SECRET=

# Pepper mixed into device token hashing (e.g. HMAC/scrypt). Keep private.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN_PEPPER=

# Number of minutes a device is considered "online" since its last heartbeat.
DEVICE_ONLINE_THRESHOLD_MINUTES=5

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
DEVICE_INGEST_RATE_LIMIT_MAX=60
