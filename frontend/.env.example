# ---------------------------------------------------------------------------
# Frontend environment variables (Vite)
# ---------------------------------------------------------------------------
# Only VITE_-prefixed variables are exposed to the browser. NEVER place
# backend-only secrets (service role keys, device tokens, DB passwords) in
# VITE_ variables — they will be visible to anyone who inspects the bundle.
# ---------------------------------------------------------------------------

# Base URL of the deployed Express backend (Render) or local backend in dev.
# Example dev:   http://localhost:8080
# Example prod:   https://your-backend.onrender.com
VITE_API_BASE_URL=

# Public Supabase project URL (used by Supabase Auth client only).
# Find in Supabase dashboard > Project Settings > API > Project URL.
VITE_SUPABASE_URL=

# Public Supabase anon key (safe for browser; NOT an authorization bypass).
# Find in Supabase dashboard > Project Settings > API > anon public.
VITE_SUPABASE_ANON_KEY=
